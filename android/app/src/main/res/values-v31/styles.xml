<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- API 31+ system SplashScreen: keep the themed background, remove the
         system-drawn icon so it cannot overlap Flutter's boot sequence. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_icon_transparent</item>
        <item name="android:statusBarColor">@color/splash_bar</item>
        <item name="android:navigationBarColor">@color/splash_bar</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@color/splash_background</item>
        <item name="android:statusBarColor">@color/splash_bar</item>
        <item name="android:navigationBarColor">@color/splash_bar</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
</resources>
